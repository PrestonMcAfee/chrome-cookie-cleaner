{
  "manifest_version": 3,
  "name": "Tab-Close Cookie Cleaner",
  "version": "2.1.1",
  "description": "Automatically purges non-whitelisted cookies on tab close and clears storage during idle maintenance.",
  "permissions": [
    "cookies",
    "tabs",
    "browsingData",
    "alarms",
    "storage",
    "contentSettings",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Tab-Close Cookie Cleaner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
